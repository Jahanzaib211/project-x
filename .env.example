# =============================================================================
# PROJECT X — local development environment
# =============================================================================
# cp .env.example .env
#
# Credentials here are DEVELOPMENT ONLY. They are deliberately weak and
# deliberately obvious so that they can never be mistaken for real ones. They
# must never appear outside a developer machine. See SECURITY.md.
# =============================================================================

COMPOSE_PROJECT_NAME=projectx
ENVIRONMENT=local
LOG_LEVEL=info
RUST_LOG=info

# -----------------------------------------------------------------------------
# HOST PORTS
# -----------------------------------------------------------------------------
# This machine already runs a lot. These ports were verified free at scaffold
# time and sit in a reserved block (27000-27019) so they cannot collide with
# your other stacks. Everything binds to 127.0.0.1 only — nothing is exposed to
# the network.
#
# Verify before starting:   make ports
# If one is taken, change it here. Nothing else needs to change.
# -----------------------------------------------------------------------------
HOST_BIND=127.0.0.1

PORT_WEB=27000               # Next.js trading terminal
PORT_CLIENT_API=27001        # REST + WebSocket edge
PORT_LEDGER=27002            # ledger service
PORT_MARKET_DATA=27003       # market data service
PORT_PRICING=27004           # pricing service
PORT_OMS=27005               # order management service
PORT_REDPANDA_CONSOLE=27006  # bus console UI
PORT_POSTGRES=27007          # PostgreSQL
PORT_REDIS=27008             # Redis
PORT_CLICKHOUSE_HTTP=27009   # ClickHouse HTTP
PORT_CLICKHOUSE_NATIVE=27010 # ClickHouse native
PORT_MINIO_API=27011         # MinIO S3 API
PORT_MINIO_CONSOLE=27012     # MinIO console
PORT_PROMETHEUS=27013        # Prometheus
PORT_GRAFANA=27014           # Grafana
PORT_JAEGER=27015            # Jaeger UI
PORT_OTLP_GRPC=27016         # OTLP gRPC ingest
PORT_OTLP_HTTP=27017         # OTLP HTTP ingest
PORT_KAFKA=27018             # Redpanda Kafka API
PORT_MAILPIT_SMTP=27019      # Mailpit SMTP sink
PORT_MAILPIT_UI=27020        # Mailpit web UI and API
PORT_FEED_GATEWAY=27021      # feed gateway (13-lp-connectivity)
PORT_MT5_SIM=27022           # MT5 bridge simulator (21-external, CI/local)
PORT_MT5_BRIDGE=27023        # MT5 bridge, real terminal under Wine (profile: external)

# -----------------------------------------------------------------------------
# OPS — the operator console (apps/ops). Separate app, separate port, separate
# deploy. It can read every client's rows and end anybody's session, so none of
# this is optional: the console refuses to start with any of them unset.
# -----------------------------------------------------------------------------
PORT_OPS=27030               # Project X Ops console

# The shared secret between the console and the client API's /v1/admin surface.
# It must match on both. The console attaches it server-side; it never reaches
# a browser.
OPS_TOKEN=generate-with-openssl-rand-base64-32

# What an operator types to get in. One passcode, rotated by editing this and
# restarting — there is no operator directory and nothing to escalate into.
OPS_PASSCODE=a-long-operator-passphrase

# Signs the console's session cookie. Changing it signs everybody out.
OPS_SESSION_SECRET=generate-with-openssl-rand-base64-48

# Let the console run gates that need the local stack. Off by default: starting
# the local stack takes the reserved ports from the deployed one.
OPS_ALLOW_GATE_STACK=false

# The host's docker group id. The console joins it to read the daemon, which is
# how its infrastructure panels report what is actually running. Find it with:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=973

# -----------------------------------------------------------------------------
# MAIL — how a password-reset or confirmation link actually reaches somebody
# -----------------------------------------------------------------------------
# none  queue only. Messages are recorded in app.outbox with the reason they
#       were not sent. Nothing is claimed and nothing arrives.
# log   write the message to the service log. For a developer who wants the
#       link without running a mail server.
# smtp  send it, over SMTP_URL.
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@projectx.local

# Mailpit in the composed stack. A real deployment points this at its provider;
# credentials go in the URL and are refused over an unencrypted connection
# unless SMTP_ALLOW_PLAINTEXT_AUTH is set, which is for a local sink only.
SMTP_URL=smtp://mailpit:1025

# -----------------------------------------------------------------------------
# POSTGRES — event store and ledger. The only source of truth.
# -----------------------------------------------------------------------------
POSTGRES_USER=projectx
POSTGRES_PASSWORD=dev_only_not_a_real_password
POSTGRES_DB=projectx
DATABASE_URL=postgres://projectx:dev_only_not_a_real_password@postgres:5432/projectx

# -----------------------------------------------------------------------------
# REDIS — projections, sessions, rate limits. Never a source of truth.
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# REDPANDA — event bus (Kafka API)
# -----------------------------------------------------------------------------
KAFKA_BROKERS=redpanda:9092

# -----------------------------------------------------------------------------
# CLICKHOUSE — analytics and reporting. Rebuildable by replay.
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=projectx
CLICKHOUSE_PASSWORD=dev_only_not_a_real_password
CLICKHOUSE_DB=projectx
CLICKHOUSE_URL=http://clickhouse:8123

# -----------------------------------------------------------------------------
# MINIO — documents, statements, artifacts, replay fixtures
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=projectx
MINIO_ROOT_PASSWORD=dev_only_not_a_real_password
S3_ENDPOINT=http://minio:9000

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=projectx
GRAFANA_USER=admin
GRAFANA_PASSWORD=dev_only_not_a_real_password

# -----------------------------------------------------------------------------
# SERVICE-TO-SERVICE (in-network names, not host ports)
# -----------------------------------------------------------------------------
LEDGER_URL=http://ledger:8000
MARKET_DATA_URL=http://market-data:8000
PRICING_URL=http://pricing:8000
OMS_URL=http://oms:8000
CLIENT_API_URL=http://client-api:8000

# -----------------------------------------------------------------------------
# IDENTITY — sign-in, sessions and second factors (19-client-api, 20-web)
# -----------------------------------------------------------------------------
# Refuse anonymous requests outright, and send signed-out visitors to /login.
#
# Off by default, and deliberately. The gate scripts and the end-to-end suite
# drive the API and the web app without a session, asserting on what the
# *financial* screens say; with this on, every one of those becomes a redirect
# and the suite proves a login form instead of the money rules. A deployment
# turns it on. Both services read it, and they must agree.
AUTH_REQUIRED=false

# Failed credential attempts allowed per source address per minute.
#
# Counted in failures, not requests: a shared egress address — an office behind
# NAT, a mobile carrier's CGNAT — would otherwise exhaust the budget with
# nothing but people successfully signing in, locking out the whole building.
# The per-account lockout (5 attempts, then 15 minutes) is the other half, and
# is the one that stops a single account being ground down.
AUTH_FAILURE_LIMIT=30

# Passwords for the two least-privilege database roles the client API creates
# and then serves as. `projectx_app` handles ordinary requests and is confined
# by row-level security to one client's rows; `projectx_auth` checks credentials
# and has no grant at all on client data. Neither is a superuser and neither may
# bypass RLS — a superuser ignores every policy silently, which is how row-level
# security comes to be deployed and do nothing. (INV-188)
DB_APP_PASSWORD=dev_only_app_role
DB_AUTH_PASSWORD=dev_only_auth_role

# Honour the `x-client-id` header as an identity.
#
# It lets one machine act as several owners without signing in, which the gate
# scripts and the end-to-end suite rely on. It is also, by construction, a way
# to name any owner you like: startup refuses it when NODE_ENV=production.
TRUST_CLIENT_ID_HEADER=true

# Expose the outbox over HTTP.
#
# With no email provider the outbox holds live password-reset links, so reading
# it is equivalent to reading somebody's inbox. It is the only way to complete a
# reset here at all, and is refused outright in production.
EXPOSE_OUTBOX=true

# The origin that reset and confirmation links point at.
PUBLIC_ORIGIN=http://127.0.0.1:27000

# -----------------------------------------------------------------------------
# MARKET DATA — where prices come from (06-market-data, 13-lp-connectivity)
# -----------------------------------------------------------------------------
# A fresh install prices every instrument synthetically: a pure function of
# the clock tick, so history is free and replay is exact. The feed gateway runs
# whichever real providers the operator console lists per instrument class,
# and market-data switches an instrument to the recorded feed the moment one
# of them speaks. Everything recorded is logged and replays identically
# (INV-054). Which sources run is chosen in Project X Ops, not here; these are
# only the credentials they need.
#
# binance    keyless. BTCUSD.
# twelvedata FX and XAU. Free key: https://twelvedata.com/
# finnhub    FX (via OANDA) and crypto. Free key: https://finnhub.io/
# mt5        the MT5 bridge (see below). All instruments the login carries.
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# Where the feed gateway finds the MT5 bridge. The simulator by default; the
# real bridge is http://mt5-bridge:8000 once `--profile external` is running.
MT5_BRIDGE_URL=http://mt5-sim:8000

# Let the *simulated* bridge be a price source. Its walk is a test fixture;
# only the end-to-end suite should ever say 1 here.
MT5_ALLOW_SIMULATED=0

# Run the simulated liquidity provider inside the gateway as well. It is what
# the contract suite and CI use; it carries no price anyone should trade on.
SIM_LP=0

# -----------------------------------------------------------------------------
# MT5 — the real bridge (services/mt5-bridge, `docker compose --profile external`)
# -----------------------------------------------------------------------------
# A MetaTrader 5 login. Any broker's demo works; a free one is opened from any
# MT5 terminal on the MetaQuotes-Demo server. Without these the bridge runs and
# reports `unconfigured`; with them it streams that login's quotes, mirrors the
# core's fills and reports the platform's own positions and deals for
# reconciliation (INV-201). The platform is never the source of truth (INV-200).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo

# -----------------------------------------------------------------------------
# DOMAIN CONFIGURATION
# -----------------------------------------------------------------------------
# Base currency for house accounts in the chart of accounts.
BASE_CURRENCY=USD
# Reject any market state older than this when pricing. Fail closed. (INV-062)
# Two seconds: what risk accepts too. A real feed delivers on its own cadence,
# batched at 250ms by the gateway, and a quote a second old is the market.
MAX_QUOTE_STALENESS_MS=2000
# Risk engine behaviour when a dependency is unavailable. Never "allow". (INV-083)
RISK_FAIL_MODE=closed
